{
    "wraps": {
        "docker-dood-base": {
            "dockerfile": "./dockers/docker/dood/base/Dockerfile",
            "build": {
                "context": "./dockers/docker/dood/base"
            },
            "run": {
                "volumes": [
                    {
                        "destination": "/var/run/docker.sock",
                        "source": "/var/run/docker.sock"
                    }
                ]
            }
        },
        "docker-dood-with-docker-installed": {
            "basedOn": [
                {
                    "name": "docker-install",
                    "tag": "latest",
                    "precreate": true
                },
                {
                    "name": "docker-dood-base",
                    "tag": "latest",
                    "precreate": true,
                    "asAbstract": true
                }
            ]
        }
    }
}