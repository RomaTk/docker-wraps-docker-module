{
    "wraps": {
        "docker-dood-base": {
            "basedOn": {
                "name": "docker-install",
                "tag": "latest",
                "precreate": true
            },
            "dockerfile": "./dockers/docker/dood/base/Dockerfile",
            "build": {
                "context": "./dockers/docker/dood/base"
            },
            "run": {
                "volumes": [
                    {
                        "destination": "/var/run/docker.sock",
                        "source": "/var/run/docker.sock"
                    }
                ]
            }
        },
        "docker-dood-volume-path-replacer": {
            "basedOn": {
                "name": "docker-dood-base",
                "tag": "latest",
                "precreate": true
            },
            "dockerfile": "./dockers/docker/dood/volume-path-replacer/Dockerfile",
            "build": {
                "context": "./dockers/docker/dood/volume-path-replacer",
                "run": {
                    "before": [
                        "(source ./env-scripts/docker/dood/volume-path-replacer/create-config.sh && main \"./secrets/docker/dood/volume-path-replacer/config.cfg\" \"./\" \"./\")"
                    ]
                }
            },
            "run": {
                "volumes": [
                    {
                        "destination": "/working-env/docker/dood/volume-path-replacer/config.cfg",
                        "source": "./secrets/docker/dood/volume-path-replacer/config.cfg"
                    }
                ]
            }
        }
    }
}